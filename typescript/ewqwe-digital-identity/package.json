{
  "name": "@ewqwe/digital-identity",
  "version": "1.1.3",
  "license": "MIT",
  "description": "JavaScript/TypeScript library for EU Digital Identity (OpenID4VP, DCQL, mDoc, SD-JWT VC, Age Verification)",
  "keywords": [
    "digital-identity",
    "openid4vp",
    "dcql",
    "mdoc",
    "sd-jwt",
    "eudi-wallet",
    "age-verification",
    "eu-av"
  ],
  "author": "ewQwe",
  "author-email": "rd@ewqwe.eu",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/lib.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rd-ewqwe/ewqwe-identity.git",
    "directory": "typescript/ewqwe-digital-identity"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --declarationDir dist --outDir dist",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "typescript": "^5.0.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
