{
  "tasks": {
    "dev": "echo 'Start backend first: deno task api, then: deno task vite, open http://localhost:5174'",
    "vite": "deno run -A npm:vite",
    "api": "deno run -A server.ts",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview"
  },
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "imports": {
    "@ewqwe/identity-front": "../js-lib/ewqwe-identity-front/mod.ts",
    "@ewqwe/identity-backend": "../js-lib/ewqwe-identity-backend/mod.ts",
    "autoprefixer": "npm:autoprefixer@^10.4.0",
    "jose": "npm:jose@^5.9.6",
    "postcss": "npm:postcss@^8.4.0",
    "tailwindcss": "npm:tailwindcss@^3.4.0",
    "vite": "npm:vite@^5.4.0"
  }
}
