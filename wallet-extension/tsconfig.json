{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["chrome"]
  },
  "include": [
    "src/**/*.ts",
    "background/**/*.ts",
    "popup/**/*.ts",
    "content/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
