{
  "name": "wallet-extension",
  "version": "0.1.0",
  "description": "EU Age Verification Wallet - Browser Extension",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
